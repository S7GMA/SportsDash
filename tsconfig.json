{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "src/app",
    "src/services",
    "src/hooks",
    "src/components/cards",
    "src/components/event",
    "src/components/layout",
    "src/components/news",
    "src/components/providers",
    "src/components/ui",
    "src/providers/api",
    "src/providers/ergast",
    "src/providers/mock",
    "src/providers/mockData.ts",
    "src/providers/MockSportsDataProvider.ts",
    "src/providers/SportsDataProvider.ts",
    "src/providers/news",
    "src/providers/CompositeSportsDataProvider.ts",
    "src/providers/RealSportsDataProvider.ts",
    "src/providers/index.ts",
    "src/lib/sportStyles.ts",
    "src/lib/theme.ts",
    "src/domain/news.ts",
    "src/pages/ExploreScreen.tsx",
    "src/pages/FavoritesSelectionPage.tsx",
    "src/pages/HomePage.tsx",
    "src/pages/LiveScreen.tsx",
    "src/pages/NewsScreen.tsx",
    "src/pages/ProfileScreen.tsx",
    "src/pages/SportSelectionPage.tsx",
    "src/pages/WelcomePage.tsx",
    "src/New File Staging",
    "src/components/TradingCard.legacy.tsx.bak"
  ]
}
